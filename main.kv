# -*- coding: utf-8 -*-
# main.kv — JCB 悠遊卡登錄程式 Android UI

<MDRoundButton@Button>:
    background_normal: ''
    background_color: 0.2, 0.6, 0.9, 1
    canvas.before:
        Color:
            rgba: self.background_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8,]

<MDRoundButtonDanger@Button>:
    background_normal: ''
    background_color: 0.8, 0.2, 0.2, 1
    canvas.before:
        Color:
            rgba: self.background_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8,]

<MDRoundButtonSuccess@Button>:
    background_normal: ''
    background_color: 0.2, 0.7, 0.3, 1
    canvas.before:
        Color:
            rgba: self.background_color
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [8,]

BoxLayout:
    orientation: 'vertical'
    padding: 16
    spacing: 10

    canvas.before:
        Color:
            rgba: 0.95, 0.95, 0.95, 1
        Rectangle:
            pos: self.pos
            size: self.size

    Label:
        text: 'JCB 悠遊卡登錄'
        font_size: 28
        bold: True
        color: 0.1, 0.3, 0.6, 1
        size_hint_y: 0.08

    ScrollView:
        size_hint_y: 0.25
        Label:
            id: status_label
            text: '載入設定中...'
            font_size: 14
            color: 0.2, 0.2, 0.2, 1
            text_size: self.width, None
            size_hint_y: None
            height: self.texture_size[1]
            halign: 'left'
            valign: 'top'

    BoxLayout:
        orientation: 'vertical'
        size_hint_y: 0.45
        Label:
            text: '執行日誌'
            font_size: 16
            bold: True
            size_hint_y: 0.08
            color: 0.1, 0.1, 0.1, 1

        ScrollView:
            TextInput:
                id: log_output
                text: ''
                readonly: True
                font_size: 11
                font_name: 'DroidSansMono'
                background_color: 0.05, 0.05, 0.05, 1
                foreground_color: 0.0, 1.0, 0.0, 1
                padding: 8, 8

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: 0.08
        spacing: 10

        MDRoundButtonSuccess:
            id: start_btn
            text: '開始登錄'
            on_press: app.start_registration()

        MDRoundButtonDanger:
            id: stop_btn
            text: '停止'
            disabled: True
            on_press: app.stop_registration()

    BoxLayout:
        orientation: 'horizontal'
        size_hint_y: 0.06
        spacing: 8
        Label:
            text: '進度:'
            size_hint_x: 0.15
            font_size: 14
        ProgressBar:
            id: progress_bar
            max: 100
            value: 0
